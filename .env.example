# --- Database (Neon Postgres) ---
# Use the pooled connection string from Neon for runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- NextAuth ---
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# In production set to your full URL (Vercel sets AUTH_URL automatically).
# AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# https://console.cloud.google.com  →  OAuth client (Web)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
